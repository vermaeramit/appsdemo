---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { services } from "../../data/services";
import { site } from "../../data/site";

const service = services.find((s) => s.slug === "web-apps")!;

const useCases = [
  {
    title: "SaaS products",
    body: "Multi-tenant SaaS with auth, billing, roles and an admin portal. The same playbook we used to build TravelERP — applied to your idea.",
    bullets: ["Multi-tenant data isolation", "Stripe / Razorpay billing & subscriptions", "Role-based permissions", "Admin / customer portals"],
  },
  {
    title: "Customer portals",
    body: "Branded portals for your customers to view orders, invoices, tickets and documents. Replace the 'email us a PDF' workflow.",
    bullets: ["SSO with your existing auth", "Self-service downloads & uploads", "Notifications via email + in-app", "Audit log per customer"],
  },
  {
    title: "Internal tools & dashboards",
    body: "Ops dashboards, approval workflows and data-entry tools that beat a shared spreadsheet. Built fast, deployed in your VPC.",
    bullets: ["Connects to your DB / warehouse", "Charts, exports, scheduled reports", "Role-based view filtering", "On-prem or cloud deploy"],
  },
  {
    title: "Marketing & content sites",
    body: "Fast static sites (like this one) with CMS-driven content, SEO, sitemap and forms. Cloudflare Pages cheap. Lighthouse-100 fast.",
    bullets: ["Astro / Next.js / Eleventy", "Headless CMS (Sanity, Strapi, Contentful)", "Forms, OG images, analytics", "DNS + deploy pipeline included"],
  },
];

const stack = [
  { label: "Frontend",  items: "React · Next.js · Astro · TypeScript · Tailwind" },
  { label: "Backend",   items: ".NET Core · Node.js · Python · PostgreSQL · MongoDB" },
  { label: "Auth",      items: "Auth0 · Clerk · custom JWT · SSO / SAML" },
  { label: "Payments",  items: "Stripe · Razorpay · Paddle · subscriptions + invoicing" },
  { label: "Hosting",   items: "Cloudflare · Vercel · AWS · Azure · your own infra" },
  { label: "Quality",   items: "CI/CD · Playwright tests · Sentry · OpenTelemetry" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Web App Development",
  description: service.description,
  serviceType: "Custom web application development",
  provider: { "@type": "Organization", name: site.name, url: site.url },
  areaServed: "Worldwide",
  offers: { "@type": "Offer", price: "150000", priceCurrency: "INR", description: "Starts from ₹1,50,000" },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",     item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name: "Services", item: `${site.url}/services` },
    { "@type": "ListItem", position: 3, name: "Web Apps", item: `${site.url}/services/web-apps` },
  ],
};
---

<BaseLayout
  title="Web App Development"
  description={service.description}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
  <!-- ─── Header ─── -->
  <section class="relative overflow-hidden">
    <div class="hero-blob"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-12 sm:pt-24 sm:pb-16">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 text-blue-700 px-3 py-1 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            Service · Custom build
          </span>
          <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
            Web apps your team and customers <span class="gradient-text">will love</span>.
          </h1>
          <p class="mt-5 text-lg text-slate-600 leading-relaxed">
            SaaS dashboards, customer portals, internal tools — built on a modern stack, multi-tenant
            and API-first by default. We built TravelERP this way. We can build yours the same.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-md hover:shadow-lg hover:opacity-95 transition"
            >
              Get a quote
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
              </svg>
            </a>
            <a
              href="/products/travel-crm"
              class="inline-flex items-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-900 bg-white border border-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition"
            >
              See an example
            </a>
          </div>
          <p class="mt-5 text-xs text-slate-500">
            Starts from <span class="font-bold text-slate-700">{service.startsFrom}</span> · Typical timeline 6–12 weeks
          </p>
        </div>

        <!-- Right-side highlights card -->
        <div class="relative">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-blue-500/10">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">What you get</p>
            <ul class="mt-3 grid grid-cols-1 gap-3 text-sm">
              {service.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 shrink-0 text-blue-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span class="text-slate-700">{h}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="absolute -inset-2 -z-10 rounded-3xl bg-gradient-to-tr from-blue-500/20 to-indigo-500/20 blur-2xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Use cases ─── -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Use cases</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          What we build
        </h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {useCases.map((u) => (
          <div class="lift rounded-2xl border border-slate-200 bg-white p-6 sm:p-7">
            <h3 class="text-xl font-bold text-slate-900">{u.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{u.body}</p>
            <ul class="mt-4 space-y-1.5">
              {u.bullets.map((b) => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="mt-0.5 shrink-0 text-blue-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Tech stack ─── -->
  <section class="py-16 sm:py-20 bg-slate-50 dot-bg">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Tech stack</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          Boring, proven, your-infra-friendly
        </h2>
        <p class="mt-4 text-slate-600 text-lg">
          We use boring tech on purpose — fewer surprises, easier to hand off, easier to hire for.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {stack.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">{s.label}</p>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">{s.items}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Got a web app in mind?"
    body="Tell us what you're trying to build and who it's for. We'll come back with rough scope, pricing and a delivery date."
    primaryLabel="Get a quote"
    primaryHref="/contact"
    secondaryLabel="Other services"
    secondaryHref="/services"
  />
</BaseLayout>
