---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { services } from "../../data/services";
import { site } from "../../data/site";

const service = services.find((s) => s.slug === "mobile-apps")!;

const useCases = [
  {
    title: "Consumer apps",
    body: "Apps your users actually open — onboarding, push notifications, in-app purchases, deep linking. Built to pass App Store review on the first try.",
    bullets: ["Polished UX with native feel", "Push notifications (FCM / APNS)", "In-app purchases & subscriptions", "Deep links + universal links"],
  },
  {
    title: "Field & ops apps",
    body: "For technicians, delivery agents, sales reps. Offline-first so the app works in the basement and syncs when you're back on Wi-Fi.",
    bullets: ["Offline-first with conflict resolution", "Barcode / QR scanning", "GPS tracking & geofencing", "Photo capture & upload"],
  },
  {
    title: "Companion apps",
    body: "A mobile front-end for your existing web app or SaaS. Shares the same API, designed for the smaller screen and one-handed use.",
    bullets: ["Reuses your existing REST/GraphQL API", "Biometric auth (FaceID / fingerprint)", "Mobile-first UX patterns", "White-label per tenant"],
  },
  {
    title: "MVP & validation builds",
    body: "Pre-funding founders: ship a credible v1 to test the idea with real users before raising. Store-ready in 8 weeks.",
    bullets: ["Fixed 8-week sprint", "Both iOS + Android from one codebase", "Analytics & funnel tracking baked in", "Documentation for handoff to a CTO"],
  },
];

const stack = [
  { label: "Framework",     items: "React Native · Expo · Flutter" },
  { label: "Language",      items: "TypeScript · Dart · Swift / Kotlin (when needed)" },
  { label: "Backend",       items: "Firebase · Supabase · custom REST · GraphQL" },
  { label: "Auth",          items: "Firebase Auth · Auth0 · custom OAuth · biometric" },
  { label: "Push & payments", items: "FCM · APNS · OneSignal · RevenueCat" },
  { label: "Distribution",  items: "App Store · Play Store · TestFlight · EAS / Fastlane" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Mobile App Development",
  description: service.description,
  serviceType: "Cross-platform mobile app development",
  provider: { "@type": "Organization", name: site.name, url: site.url },
  areaServed: "Worldwide",
  offers: { "@type": "Offer", price: "200000", priceCurrency: "INR", description: "Starts from ₹2,00,000" },
};
---

<BaseLayout
  title="Mobile App Development"
  description={service.description}
  jsonLd={jsonLd}
>
  <!-- ─── Header ─── -->
  <section class="relative overflow-hidden">
    <div class="hero-blob"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-12 sm:pt-24 sm:pb-16">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 text-emerald-700 px-3 py-1 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Service · iOS + Android
          </span>
          <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
            Native-feel mobile apps, <span class="gradient-text">half the budget</span>.
          </h1>
          <p class="mt-5 text-lg text-slate-600 leading-relaxed">
            Cross-platform iOS + Android with React Native or Flutter — one codebase, native
            performance, store-ready. From MVP to v1.0 in 8–12 weeks.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-md hover:shadow-lg hover:opacity-95 transition"
            >
              Get a quote
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
              </svg>
            </a>
            <a
              href="/services"
              class="inline-flex items-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-900 bg-white border border-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition"
            >
              All services
            </a>
          </div>
          <p class="mt-5 text-xs text-slate-500">
            Starts from <span class="font-bold text-slate-700">{service.startsFrom}</span> · Typical timeline 8–12 weeks
          </p>
        </div>

        <!-- Right-side highlights card -->
        <div class="relative">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-emerald-500/10">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">What you get</p>
            <ul class="mt-3 grid grid-cols-1 gap-3 text-sm">
              {service.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 shrink-0 text-emerald-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span class="text-slate-700">{h}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="absolute -inset-2 -z-10 rounded-3xl bg-gradient-to-tr from-emerald-500/20 to-teal-500/20 blur-2xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Use cases ─── -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Use cases</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          What we build
        </h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {useCases.map((u) => (
          <div class="lift rounded-2xl border border-slate-200 bg-white p-6 sm:p-7">
            <h3 class="text-xl font-bold text-slate-900">{u.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{u.body}</p>
            <ul class="mt-4 space-y-1.5">
              {u.bullets.map((b) => (
                <li class="flex items-start gap-2 text-sm text-slate-700">
                  <svg class="mt-0.5 shrink-0 text-emerald-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Tech stack ─── -->
  <section class="py-16 sm:py-20 bg-slate-50 dot-bg">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Tech stack</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          Cross-platform, store-ready, instrumented
        </h2>
        <p class="mt-4 text-slate-600 text-lg">
          We default to React Native + Expo for speed, with native modules where it matters.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {stack.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">{s.label}</p>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">{s.items}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Ship a mobile app this quarter"
    body="Tell us about the app — who uses it, what it does, when you need it live. We'll come back with rough scope, pricing and a delivery date."
    primaryLabel="Get a quote"
    primaryHref="/contact"
    secondaryLabel="Other services"
    secondaryHref="/services"
  />
</BaseLayout>
