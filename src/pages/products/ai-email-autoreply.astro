---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { products } from "../../data/products";
import { site } from "../../data/site";

const product = products.find((p) => p.slug === "ai-email-autoreply")!;

const modules = [
  {
    title: "Connect your inbox",
    body: "One-click OAuth with Gmail or Microsoft 365. We never store your password — only the refresh token, which you can revoke from your Google / Microsoft account at any time. Pulls new messages over IMAP / Graph API; outbound replies go through your existing SMTP / Graph so they look like they came from you.",
    bullets: [
      "Gmail and Microsoft 365 / Outlook supported",
      "Per-mailbox connection — works for personal or shared inboxes",
      "Read-only mode option (drafts only, never sends)",
      "Revoke at any time from your provider's security settings",
    ],
  },
  {
    title: "Learns your tone",
    body: "Most AI reply tools sound like a robot — formal, sterile, and obviously not you. AI Email AutoReply trains on your last 12 months of sent mail to learn your voice — how you greet, how you sign off, how formal you are, the phrases you reuse. The drafted reply reads like you actually wrote it.",
    bullets: [
      "Per-user style model trained on your sent folder",
      "Honors your signature, greeting and sign-off patterns",
      "Per-mailbox tone (formal for sales, casual for internal)",
      "Re-train any time as your style evolves",
    ],
  },
  {
    title: "Two modes: Review or Autonomous",
    body: "Review-then-send is the default — the AI drafts every reply, you read it, hit Send (or edit first). Autonomous mode lets the AI send replies it's highly confident about and only escalates the ambiguous ones to your inbox. You pick the confidence threshold; we recommend Review-only for the first month.",
    bullets: [
      "Review mode — drafts appear in your inbox as drafts",
      "Autonomous mode — AI sends below a confidence threshold",
      "Per-sender rules — VIPs always go to you, even on autonomous",
      "Full audit log of every reply the AI sent",
    ],
  },
  {
    title: "Knows your business",
    body: "Connect your help docs, FAQs, product manuals, SOPs or even your CRM and the AI uses them as a knowledge base when drafting replies. Answers about pricing, refunds, shipping, hours — pulled from your real sources with citations, not made up.",
    bullets: [
      "RAG on your docs (Google Drive, Notion, Confluence, PDFs)",
      "CRM integration — replies that know the customer's history",
      "Cites the source document on every fact-based answer",
      "Per-team knowledge bases for shared inboxes",
    ],
  },
  {
    title: "Sentiment routing + safety rails",
    body: "Not every email should get an AI reply. AI Email AutoReply detects sentiment, urgency and topic — anything angry, sensitive, legal or out-of-scope is held back and notified to a human. You configure what counts as escalation-worthy.",
    bullets: [
      "Sentiment + urgency classification on every incoming message",
      "Hard-block topics (legal threats, refunds, complaints)",
      "Escalation goes to a configurable Slack channel or inbox",
      "Audit trail for compliance (who replied, what was sent)",
    ],
  },
];

const stack = [
  { label: "Models",      items: "Claude 4.x · GPT-4o · open-source for on-prem" },
  { label: "Inbox APIs",  items: "Gmail API · Microsoft Graph · IMAP/SMTP fallback" },
  { label: "Retrieval",   items: "pgvector · Pinecone · your existing CRM as a source" },
  { label: "Hosting",     items: "AppsDemo cloud (default) · your own VPC (Enterprise)" },
  { label: "Security",    items: "OAuth refresh tokens only · per-tenant DB · audit log" },
  { label: "Integrations",items: "Slack escalations · CRM (TravelERP, HubSpot, Pipedrive)" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "AI Email AutoReply",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: product.description,
  url: `${site.url}/products/ai-email-autoreply`,
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/PreOrder",
    description: "Beta — join the waitlist for early access",
  },
  publisher: { "@type": "Organization", name: site.name, url: site.url },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",                item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name: "Products",            item: `${site.url}/#products` },
    { "@type": "ListItem", position: 3, name: "AI Email AutoReply",  item: `${site.url}/products/ai-email-autoreply` },
  ],
};

const waitlistHref = "/contact?topic=ai-email-autoreply#contactForm";
---

<BaseLayout
  title="AI Email AutoReply — never let an important email sit unanswered"
  description="AI email assistant that connects to Gmail or Outlook, learns your tone from your sent folder and drafts replies that sound like you. Beta — join the waitlist."
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
>
  <!-- ─── Header ─── -->
  <section class="relative overflow-hidden">
    <div class="hero-blob"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-12 sm:pt-24 sm:pb-16">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full bg-amber-50 text-amber-700 px-3 py-1 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
            Beta · Early access
          </span>
          <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
            Never let an important email <span class="gradient-text">sit unanswered</span>.
          </h1>
          <p class="mt-5 text-lg text-slate-600 leading-relaxed">
            AI Email AutoReply connects to your Gmail or Outlook, learns your tone from your sent
            folder, and drafts replies that actually sound like you — backed by your own docs and
            CRM. Review-then-send by default. Fully autonomous when you trust it.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={waitlistHref}
              class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-md hover:shadow-lg hover:opacity-95 transition"
            >
              Join the waitlist
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
              </svg>
            </a>
            <a
              href="#how"
              class="inline-flex items-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-900 bg-white border border-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition"
            >
              See how it works
            </a>
          </div>
          <p class="mt-5 text-xs text-slate-500">
            Free during beta · Limited to ~50 mailboxes · Closed beta is invite-by-invite
          </p>
        </div>

        <!-- Right-side highlights card -->
        <div class="relative">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-rose-500/10">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">What's in the beta</p>
            <ul class="mt-3 grid grid-cols-1 gap-3 text-sm">
              {product.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 shrink-0 text-rose-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span class="text-slate-700">{h}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="absolute -inset-2 -z-10 rounded-3xl bg-gradient-to-tr from-rose-500/20 to-pink-500/20 blur-2xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Modules ─── -->
  <section id="how" class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">How it works</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          From "inbox zero is a fantasy" to a real workflow
        </h2>
      </div>

      <div class="mt-14 space-y-12 sm:space-y-16">
        {modules.map((s, i) => (
          <div class={`grid gap-8 lg:grid-cols-2 lg:items-center ${i % 2 === 1 ? "lg:[&>:first-child]:order-2" : ""}`}>
            <div>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">{s.title}</h3>
              <p class="mt-3 text-slate-600 leading-relaxed">{s.body}</p>
              <ul class="mt-5 space-y-2">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm text-slate-700">
                    <svg class="mt-0.5 shrink-0 text-rose-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-6 sm:p-8 shadow-sm">
              <div class="aspect-[4/3] rounded-xl bg-white border border-slate-200 grid place-items-center text-slate-300">
                <span class="text-sm font-medium tracking-wide uppercase">{s.title} preview</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Tech stack ─── -->
  <section class="py-16 sm:py-20 bg-slate-50 dot-bg">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Tech stack</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          Modern, model-agnostic, your-infra-friendly
        </h2>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {stack.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">{s.label}</p>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">{s.items}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── FAQ ─── -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 text-center">
        Common questions
      </h2>
      <div class="mt-10 space-y-3">
        <details class="group rounded-xl border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer list-none flex items-center justify-between font-semibold text-slate-900">
            Will the AI ever send something embarrassing?
            <svg class="shrink-0 transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            Default mode is Review-then-send — every reply is a draft waiting for your one-click
            approval. Autonomous mode is opt-in per-mailbox and per-confidence-threshold. Anything
            below the threshold, anything sentiment-flagged, anything from a VIP — always goes to
            you. We strongly recommend Review-mode for the first month so you can build trust
            before flipping the switch.
          </p>
        </details>
        <details class="group rounded-xl border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer list-none flex items-center justify-between font-semibold text-slate-900">
            Where does the AI run? Is my mail safe?
            <svg class="shrink-0 transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            By default, the service runs on our cloud (Cloudflare / AWS regions in India and
            Singapore). Your mailbox is connected via OAuth — we never see or store your password.
            Email content is processed in-memory for drafting and is not used to train any shared
            model. Enterprise plans support deployment to your own VPC so emails never leave your
            infrastructure.
          </p>
        </details>
        <details class="group rounded-xl border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer list-none flex items-center justify-between font-semibold text-slate-900">
            What does it cost?
            <svg class="shrink-0 transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            Beta is free for the first ~50 mailboxes. After beta, pricing tiers will follow the
            AppsDemo product pattern — Starter / Business / Enterprise with monthly per-seat
            pricing in INR. Waitlist members get a permanent founder discount.
          </p>
        </details>
        <details class="group rounded-xl border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer list-none flex items-center justify-between font-semibold text-slate-900">
            When does it launch publicly?
            <svg class="shrink-0 transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            Closed beta is live for invited mailboxes now. Open beta will follow when we're
            comfortable the autonomous mode is safe at scale. Join the waitlist to get the next
            invite slot.
          </p>
        </details>
      </div>
    </div>
  </section>

  <CtaBanner
    title="Join the AI Email AutoReply waitlist"
    body="Tell us about your inbox — volume, what kind of replies you send, what you'd want the AI to handle. We'll send your invite when a beta slot opens."
    primaryLabel="Get on the waitlist"
    primaryHref={waitlistHref}
    secondaryLabel="See our products"
    secondaryHref="/#products"
  />
</BaseLayout>
