---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogHero from "../../components/BlogHero.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${site.url}/blog` },
  ],
};
---

<BaseLayout
  title="Blog"
  description={`Engineering notes, product updates and field reports from ${site.name}. Travel tech, AI, SaaS and the lessons we've learnt building software for small businesses.`}
  jsonLd={breadcrumbJsonLd}
>
  <!-- ─── Hero ─── -->
  <section class="relative overflow-hidden">
    <div class="hero-blob"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-20 pb-10 sm:pt-24 text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Blog</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        Notes from <span class="gradient-text">building software</span>
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-slate-600 text-lg leading-relaxed">
        Engineering deep-dives, product updates and field reports from real client work.
        Travel tech, AI, SaaS and the lessons we've learnt along the way.
      </p>
    </div>
  </section>

  <!-- ─── Posts grid ─── -->
  <section class="pb-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-center text-slate-500">No posts yet — check back soon.</p>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}`}
                class="lift group flex flex-col h-full rounded-2xl border border-slate-200 bg-white overflow-hidden"
              >
                <BlogHero
                  title={post.data.title}
                  tags={post.data.tags}
                  accent={post.data.heroAccent}
                  heroImage={post.data.heroImage}
                  variant="card"
                />
                <div class="flex flex-col p-6 flex-1">
                  <p class="text-xs font-semibold text-slate-500">
                    <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                  </p>
                  <h2 class="mt-2 text-lg font-bold text-slate-900 leading-snug group-hover:text-indigo-600 transition">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-1.5">
                      {post.data.tags.slice(0, 3).map((t) => (
                        <li class="text-[11px] font-medium text-slate-600 bg-slate-100 px-2 py-0.5 rounded">{t}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
