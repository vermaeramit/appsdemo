---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." noindex={true}>
  <section class="relative min-h-[60vh] grid place-items-center px-4">
    <div class="hero-blob"></div>
    <div class="relative text-center max-w-md">
      <p class="text-7xl sm:text-8xl font-extrabold gradient-text">404</p>
      <h1 class="mt-4 text-2xl sm:text-3xl font-extrabold text-slate-900">Page not found</h1>
      <p class="mt-3 text-slate-600">The page you were looking for has packed its bags and gone on holiday.</p>
      <a href="/" class="mt-6 inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-md hover:shadow-lg hover:opacity-95 transition">
        Take me home
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
