---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact"
  description={`Get in touch with the ${site.name} team. We usually reply within one business day.`}
>
  <section class="relative overflow-hidden">
    <div class="hero-blob"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-12 sm:pt-24">
      <div class="grid gap-12 lg:grid-cols-5 lg:items-start">
        <!-- Intro -->
        <div class="lg:col-span-2">
          <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Contact</p>
          <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
            Talk to a <span class="gradient-text">real human</span>.
          </h1>
          <p class="mt-5 text-slate-600 text-lg leading-relaxed">
            Questions about TravelERP, custom pricing, a demo, or just curious what we're building next?
            Send us a note — we usually reply within one business day.
          </p>

          <ul class="mt-8 space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Email</p>
                <a href={`mailto:${site.contactEmail}`} class="text-slate-600 hover:text-indigo-600 transition">{site.contactEmail}</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Response time</p>
                <p class="text-slate-600">Within 1 business day (IST)</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Based in</p>
                <p class="text-slate-600">India · Remote-first</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Form card -->
        <div class="lg:col-span-3">
          <div class="relative rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xl shadow-indigo-500/10">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
