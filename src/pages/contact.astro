---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact"
  description={`Get in touch with the ${site.name} team. We usually reply within one business day.`}
>
  <section class="relative overflow-hidden">
    <div class="hero-blob"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-12 sm:pt-24">
      <div class="grid gap-12 lg:grid-cols-5 lg:items-start">
        <!-- Intro -->
        <div class="lg:col-span-2">
          <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Contact</p>
          <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
            Talk to a <span class="gradient-text">real human</span>.
          </h1>
          <p class="mt-5 text-slate-600 text-lg leading-relaxed">
            Questions about TravelERP, custom pricing, a demo, or just curious what we're building next?
            Send us a note — we usually reply within one business day.
          </p>

          <ul class="mt-8 space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Email</p>
                <a href={`mailto:${site.contactEmail}`} class="text-slate-600 hover:text-indigo-600 transition">{site.contactEmail}</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Phone</p>
                <a href={`tel:${site.phone}`} class="text-slate-600 hover:text-indigo-600 transition">{site.phoneDisplay}</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.49 0 .15 5.34.15 11.91c0 2.1.55 4.15 1.6 5.96L0 24l6.27-1.65a11.86 11.86 0 0 0 5.78 1.47h.01c6.57 0 11.91-5.34 11.91-11.91 0-3.18-1.24-6.17-3.45-8.43zM12.06 21.79h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.72.98.99-3.63-.23-.37a9.84 9.84 0 0 1-1.52-5.27c0-5.45 4.44-9.89 9.89-9.89 2.64 0 5.13 1.03 6.99 2.9a9.81 9.81 0 0 1 2.9 6.99c0 5.45-4.44 9.89-9.9 9.89zm5.43-7.41c-.3-.15-1.76-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">WhatsApp</p>
                <a
                  href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-600 hover:text-emerald-600 transition"
                >
                  Chat with us on WhatsApp →
                </a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Response time</p>
                <p class="text-slate-600">Within 1 business day (IST)</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid place-items-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <div>
                <p class="font-semibold text-slate-900">Based in</p>
                <p class="text-slate-600">India · Remote-first</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Form card -->
        <div class="lg:col-span-3">
          <div class="relative rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xl shadow-indigo-500/10">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
