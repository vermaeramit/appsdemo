---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ClientsStrip from "../components/ClientsStrip.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { projects } from "../data/projects";
import { clients } from "../data/clients";
import { site } from "../data/site";

const yearsActive = new Date().getFullYear() - site.founded;

// Group projects by category for the "by type" view
const categories = ["Travel CRM", "Marketing Site", "Education Platform", "Exam Portal"] as const;

const portfolioJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Portfolio — ${site.name}`,
  url: `${site.url}/portfolio`,
  description: `Projects delivered by ${site.name}: travel CRMs, marketing sites, education platforms and exam portals.`,
  about: projects.map((p) => ({
    "@type": "CreativeWork",
    name: p.name,
    url: p.url,
    description: p.description,
  })),
};
---

<BaseLayout
  title="Portfolio"
  description={`Projects we've built and deployed: ${projects.length} live applications across travel, education and SaaS — used by ${clients.length}+ teams.`}
  jsonLd={portfolioJsonLd}
>
  <!-- ─── Hero ─── -->
  <section class="relative overflow-hidden">
    <div class="hero-blob"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-20 pb-10 sm:pt-24 text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Our work</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        Shipped, live, in <span class="gradient-text">real customer hands</span>.
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-slate-600 text-lg leading-relaxed">
        {site.projectsDelivered}+ projects delivered since {site.founded} — travel agencies running our TravelERP,
        academic publishers, exam platforms and customer-facing marketing sites. A selection is featured below.
      </p>

      <!-- Quick stat strip -->
      <div class="mt-10 grid grid-cols-3 gap-4 max-w-xl mx-auto">
        <div>
          <p class="text-3xl sm:text-4xl font-extrabold gradient-text">{yearsActive}+</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Years of experience</p>
        </div>
        <div>
          <p class="text-3xl sm:text-4xl font-extrabold gradient-text">{site.projectsDelivered}+</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Projects delivered</p>
        </div>
        <div>
          <p class="text-3xl sm:text-4xl font-extrabold gradient-text">100%</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">In production</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Clients strip ─── -->
  <ClientsStrip title="Some of the teams we've worked with" />

  <!-- ─── Projects grid ─── -->
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- ─── By type breakdown ─── -->
  <section class="py-16 sm:py-20 bg-slate-50 dot-bg">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">By type</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          What we've built across categories
        </h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((cat) => {
          const count = projects.filter((p) => p.category === cat).length;
          if (count === 0) return null;
          return (
            <div class="rounded-2xl border border-slate-200 bg-white p-5">
              <p class="text-3xl font-extrabold gradient-text">{count}</p>
              <p class="mt-2 font-bold text-slate-900">{cat}{count > 1 ? "s" : ""}</p>
              <ul class="mt-3 space-y-1.5 text-sm text-slate-600">
                {projects.filter((p) => p.category === cat).map((p) => (
                  <li class="truncate">
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 transition">
                      {p.name.replace(/ —.*$/, "")}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Want to be on this page?"
    body="Tell us what you're building. We'll come back with rough scope, pricing and a delivery date — and ship a project you'll be proud to link from your own site."
    primaryLabel="Start a project"
    primaryHref="/contact"
    secondaryLabel="See our services"
    secondaryHref="/services"
  />
</BaseLayout>
