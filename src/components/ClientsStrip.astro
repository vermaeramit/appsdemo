---
import { clients } from "../data/clients";
import ClientLogo from "./ClientLogo.astro";

interface Props {
  title?: string;
  compact?: boolean;
}
const { title = "Trusted by teams building real businesses", compact = false } = Astro.props;
---

<section class={compact ? "py-10" : "py-14 sm:py-16"}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {title && (
      <p class="text-center text-xs sm:text-sm font-bold uppercase tracking-widest text-slate-500">
        {title}
      </p>
    )}

    <div class="mt-6 grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-4 items-center justify-items-center">
      {clients.map((c) => (
        <a
          href={c.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={c.name}
          class="group inline-flex items-center justify-center"
        >
          <ClientLogo client={c} size="h-10 sm:h-12" monochrome={true} />
        </a>
      ))}
    </div>
  </div>
</section>
