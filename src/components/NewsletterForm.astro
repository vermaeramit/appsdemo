---
interface Props {
  variant?: "block" | "footer";
  source?: string;       // tag so we know where the subscription came from
  heading?: string;
  body?: string;
}
const {
  variant = "block",
  source = "blog",
  heading = "Stay in the loop",
  body = "One post every two weeks on travel tech, AI and SaaS. No spam, no upsells.",
} = Astro.props;
---

{variant === "block" ? (
  <section class="my-12 sm:my-16">
    <div class="mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-gradient-to-br from-indigo-50 via-white to-cyan-50 p-6 sm:p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">Newsletter</p>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
        {heading}
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed">{body}</p>

      <form data-newsletter class="mt-5 flex flex-col sm:flex-row gap-3">
        <input type="hidden" name="source" value={source} />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="sr-only" for={`newsletter-email-${source}`}>Email address</label>
        <input
          id={`newsletter-email-${source}`}
          type="email"
          name="email"
          required
          maxlength="120"
          placeholder="you@company.com"
          autocomplete="email"
          class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-sm hover:shadow-md hover:opacity-95 transition disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Subscribe
        </button>
      </form>
      <p data-newsletter-status class="text-xs mt-2 text-slate-500"></p>
    </div>
  </section>
) : (
  <div>
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Stay in the loop</h3>
    <p class="mt-3 text-sm text-slate-600">{body}</p>
    <form data-newsletter class="mt-3 flex flex-col gap-2">
      <input type="hidden" name="source" value={source} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label class="sr-only" for={`newsletter-email-footer-${source}`}>Email address</label>
      <input
        id={`newsletter-email-footer-${source}`}
        type="email"
        name="email"
        required
        maxlength="120"
        placeholder="you@company.com"
        autocomplete="email"
        class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition"
      />
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-lg px-3.5 py-2 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-sm hover:shadow-md hover:opacity-95 transition disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Subscribe
      </button>
      <p data-newsletter-status class="text-xs text-slate-500"></p>
    </form>
  </div>
)}

<script src="/scripts/newsletter.js" defer></script>
