---
import { site } from "../data/site";

interface Props {
  title: string;
  tags?: readonly string[];
  accent?: string;            // tailwind gradient classes, e.g. "from-indigo-500 to-cyan-500"
  heroImage?: string;         // if set, renders the image instead of the styled hero
  variant?: "page" | "card";  // page = large hero on post; card = compact hero on /blog index
  href?: string;              // only used to derive the path label on the page hero
}
const {
  title,
  tags = [],
  accent = "from-indigo-500 to-cyan-500",
  heroImage,
  variant = "page",
  href,
} = Astro.props;

// Pick a category-appropriate emoji icon based on the primary tag.
// Falls back to a generic article glyph.
const primaryTag = (tags[0] ?? "").toLowerCase();
const tagIcon: Record<string, string> = {
  whatsapp: "💬",
  ai: "🤖",
  chatbots: "💬",
  automation: "⚡",
  "travel crm": "✈",
  travel: "✈",
  "buyer's guide": "🧭",
  travelerp: "✈",
  case: "📂",
  engineering: "🛠",
  technical: "⚙",
  customer: "💬",
  support: "💬",
};
const icon =
  Object.entries(tagIcon).find(([k]) => primaryTag.includes(k))?.[1] ?? "📝";

const pathLabel = href ? `appsdemo.in${href}` : "appsdemo.in/blog";

const wrapBase = "relative overflow-hidden aspect-[16/9]";
const wrapVariant =
  variant === "card"
    ? ""  // parent card already provides rounding + border
    : "rounded-2xl border border-slate-200 shadow-xl shadow-indigo-500/10";
---

{heroImage ? (
  <div class={[wrapBase, wrapVariant].join(" ")}>
    <img src={heroImage} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
  </div>
) : (
  <div class={[wrapBase, wrapVariant, "bg-gradient-to-br", accent].join(" ")}>
    <!-- Decorative blobs -->
    <div class="absolute -top-16 -right-16 w-72 h-72 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
    <div class="absolute -bottom-20 -left-12 w-80 h-80 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
    <div class="absolute top-1/3 right-1/4 w-40 h-40 rounded-full border border-white/30" aria-hidden="true"></div>

    <!-- Dotted overlay pattern -->
    <div
      class="absolute inset-0 opacity-25 pointer-events-none"
      style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 22px 22px;"
      aria-hidden="true"
    ></div>

    <!-- Foreground content -->
    <div class={[
      "relative h-full flex flex-col text-white",
      variant === "card" ? "p-4 justify-between" : "p-6 sm:p-10 justify-between",
    ].join(" ")}>
      <!-- Top: tags -->
      <div class="flex flex-wrap gap-2">
        {tags.slice(0, variant === "card" ? 1 : 3).map((t) => (
          <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-widest bg-white/15 backdrop-blur px-2.5 py-1 rounded-full">
            {t}
          </span>
        ))}
      </div>

      <!-- Centre: icon (only on the page variant; cards stay clean) -->
      {variant === "page" && (
        <div class="grid place-items-center -mt-4">
          <span class="text-5xl sm:text-7xl drop-shadow-md" aria-hidden="true">{icon}</span>
        </div>
      )}

      <!-- Bottom: brand mark -->
      <div class="flex items-center justify-between text-white/80">
        {variant === "page" ? (
          <>
            <p class="text-[10px] sm:text-xs font-mono">{pathLabel}</p>
            <p class="text-xs sm:text-sm font-extrabold tracking-tight">{site.name}</p>
          </>
        ) : (
          <p class="text-[10px] font-extrabold tracking-tight ml-auto">{site.name}</p>
        )}
      </div>
    </div>
  </div>
)}
