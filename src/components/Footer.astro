---
import { site } from "../data/site";
import { products } from "../data/products";
import { services } from "../data/services";
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-10 md:grid-cols-5">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2">
          <span class="grid place-items-center w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-cyan-500 text-white font-extrabold shadow-sm">A</span>
          <span class="font-extrabold tracking-tight text-slate-900">{site.name}</span>
        </a>
        <p class="mt-3 text-sm text-slate-600 max-w-xs">{site.tagline}</p>
        <a href={`mailto:${site.contactEmail}`} class="mt-3 block text-sm font-medium text-indigo-600 hover:text-indigo-700">
          {site.contactEmail}
        </a>
        <a href={`tel:${site.phone}`} class="mt-1 block text-sm font-medium text-slate-700 hover:text-indigo-600">
          {site.phoneDisplay}
        </a>
        <a
          href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600 hover:text-emerald-700"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.49 0 .15 5.34.15 11.91c0 2.1.55 4.15 1.6 5.96L0 24l6.27-1.65a11.86 11.86 0 0 0 5.78 1.47h.01c6.57 0 11.91-5.34 11.91-11.91 0-3.18-1.24-6.17-3.45-8.43z"/></svg>
          WhatsApp us
        </a>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Products</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {products.map((p) => (
            <li>
              <a href={p.href} class="text-slate-600 hover:text-indigo-600 transition">
                {p.name}{p.status !== "live" && <span class="ml-1.5 text-[10px] uppercase tracking-wider text-amber-600">Soon</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Services</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {services.map((s) => (
            <li>
              <a href={s.href} class="text-slate-600 hover:text-indigo-600 transition">{s.name}</a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-indigo-600 hover:text-indigo-700 font-semibold transition">All services →</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Company</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/portfolio" class="text-slate-600 hover:text-indigo-600 transition">Our work</a></li>
          <li><a href="/about" class="text-slate-600 hover:text-indigo-600 transition">About</a></li>
          <li><a href="/pricing" class="text-slate-600 hover:text-indigo-600 transition">Pricing</a></li>
          <li><a href="/contact" class="text-slate-600 hover:text-indigo-600 transition">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-slate-200 flex flex-col md:flex-row items-center justify-between gap-3 text-sm text-slate-500">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Made with care · <a href="/" class="underline-offset-2 hover:underline">{site.name}</a></p>
    </div>
  </div>
</footer>
