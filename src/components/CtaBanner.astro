---
interface Props {
  title?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  title = "Ready to ditch spreadsheets?",
  body  = "Start your free 30-day trial of TravelERP — your team will be running quotes the same afternoon.",
  primaryHref   = "https://crm.appsdemo.in/register",
  primaryLabel  = "Start free trial",
  secondaryHref = "/contact",
  secondaryLabel = "Book a 15-min demo",
} = Astro.props;
---

<section class="px-4 sm:px-6 lg:px-8 my-16">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-cyan-700 text-white shadow-xl shadow-indigo-500/20">
    <!-- Decorative blobs -->
    <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-white/10 blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-cyan-300/20 blur-3xl"></div>

    <div class="relative px-6 sm:px-10 py-12 sm:py-16 flex flex-col items-center text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{title}</h2>
      <p class="mt-3 max-w-2xl text-white/85 text-base sm:text-lg">{body}</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={primaryHref}
          class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-indigo-700 shadow-md hover:shadow-lg hover:opacity-95 transition"
        >
          {primaryLabel}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
          </svg>
        </a>
        <a
          href={secondaryHref}
          class="inline-flex items-center rounded-xl px-5 py-3 text-sm font-semibold text-white border border-white/30 hover:bg-white/10 transition"
        >
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
