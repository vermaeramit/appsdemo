---
// Pure markup. Submission is handled by /scripts/contact-form.js which POSTs
// to /api/contact (handled by src/worker.ts). SMTP credentials live in
// Cloudflare Worker secrets — never in the browser.
---

<form
  id="contactForm"
  action="/api/contact"
  method="POST"
  data-endpoint="/api/contact"
  class="space-y-4"
>
  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label for="name" class="block text-sm font-semibold text-slate-800">Your name</label>
      <input id="name" name="name" type="text" required maxlength="80"
             class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition"
             placeholder="Jane Doe" />
    </div>
    <div>
      <label for="email" class="block text-sm font-semibold text-slate-800">Email</label>
      <input id="email" name="email" type="email" required maxlength="120"
             class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition"
             placeholder="jane@company.com" />
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label for="phone" class="block text-sm font-semibold text-slate-800">Mobile number</label>
      <input id="phone" name="phone" type="tel" required maxlength="20" inputmode="tel"
             autocomplete="tel"
             class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition"
             placeholder="+91 98765 43210" />
    </div>
    <div>
      <label for="company" class="block text-sm font-semibold text-slate-800">Company <span class="text-slate-400 font-normal">(optional)</span></label>
      <input id="company" name="company" type="text" maxlength="120"
             class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition"
             placeholder="Acme Travels" />
    </div>
  </div>

  <div>
    <label for="topic" class="block text-sm font-semibold text-slate-800">I'm interested in</label>
    <select id="topic" name="topic"
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition">
      <optgroup label="Products">
        <option value="travel-crm">TravelERP — travel agency CRM</option>
        <option value="ai-email-autoreply">AI Email AutoReply (beta — join waitlist)</option>
        <option value="inventory-pro">Inventory Pro (coming soon)</option>
        <option value="hr-hub">HR Hub (coming soon)</option>
      </optgroup>
      <optgroup label="Services">
        <option value="ai-chatbots">AI Chatbot development</option>
        <option value="web-apps">Web app development</option>
        <option value="mobile-apps">Mobile app development</option>
      </optgroup>
      <option value="other">Something else</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-semibold text-slate-800">Message</label>
    <textarea id="message" name="message" rows="4" required maxlength="2000"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm placeholder:text-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition"
              placeholder="Tell us a bit about your team and what you're looking to solve..."></textarea>
  </div>

  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <button type="submit" id="contactSubmit"
          class="inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-md hover:shadow-lg hover:opacity-95 transition w-full sm:w-auto disabled:opacity-60 disabled:cursor-not-allowed">
    Send message
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    </svg>
  </button>

  <p id="contactStatus" class="text-sm" role="status" aria-live="polite"></p>
</form>

<script src="/scripts/contact-form.js" defer></script>
