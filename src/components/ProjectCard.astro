---
import type { Project } from "../data/projects";
import { clients } from "../data/clients";
import ClientLogo from "./ClientLogo.astro";

interface Props { project: Project; }
const { project } = Astro.props;

const client = clients.find((c) => c.slug === project.clientSlug)!;

const categoryStyle: Record<Project["category"], string> = {
  "Travel CRM":         "bg-indigo-100 text-indigo-700",
  "Marketing Site":     "bg-amber-100  text-amber-700",
  "Education Platform": "bg-blue-100   text-blue-700",
  "Exam Portal":        "bg-emerald-100 text-emerald-700",
};
---

<article class="lift group flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden">
  <!-- Top accent band — holds the client logo, with a soft gradient + faux browser chrome -->
  <div class={`relative bg-gradient-to-br ${project.accent} px-6 pt-5 pb-8`}>
    <div class="flex items-center gap-1.5 mb-4 opacity-70">
      <span class="w-2 h-2 rounded-full bg-white/70"></span>
      <span class="w-2 h-2 rounded-full bg-white/70"></span>
      <span class="w-2 h-2 rounded-full bg-white/70"></span>
      <span class="ml-2 text-[10px] text-white/80 font-mono truncate">{new URL(project.url).host}</span>
    </div>
    <div class="rounded-xl bg-white p-4 shadow-md min-h-[72px] flex items-center justify-center">
      <ClientLogo client={client} size="h-10 sm:h-12" monochrome={false} />
    </div>
  </div>

  <!-- Body -->
  <div class="flex flex-col p-6 flex-1">
    <div class="flex items-center justify-between gap-3">
      <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full ${categoryStyle[project.category]}`}>
        {project.category}
      </span>
      {project.year && (
        <span class="text-xs font-medium text-slate-400">{project.year}</span>
      )}
    </div>

    <h3 class="mt-3 text-lg font-bold text-slate-900 leading-snug">{project.name}</h3>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{project.description}</p>

    {project.tech && project.tech.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {project.tech.map((t) => (
          <li class="text-[11px] font-medium text-slate-600 bg-slate-100 px-2 py-0.5 rounded">{t}</li>
        ))}
      </ul>
    )}

    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 hover:text-indigo-700"
    >
      Visit live
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
      </svg>
    </a>
  </div>
</article>
