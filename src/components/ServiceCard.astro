---
import type { Service } from "../data/services";
interface Props { service: Service; }
const { service } = Astro.props;
---

<a
  href={service.href}
  class="lift relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 cursor-pointer hover:border-indigo-300"
>
  <div class="flex items-start justify-between">
    <div class={`grid place-items-center w-12 h-12 rounded-xl bg-gradient-to-br ${service.iconColor} text-white text-xl font-bold shadow-sm`}>
      <span aria-hidden="true">{service.icon}</span>
    </div>
    {service.startsFrom && (
      <span class="text-[11px] font-semibold text-slate-500">
        from <span class="text-slate-900 font-bold">{service.startsFrom}</span>
      </span>
    )}
  </div>

  <h3 class="mt-5 text-xl font-bold text-slate-900">{service.name}</h3>
  <p class="mt-1 text-sm font-medium text-indigo-600">{service.tagline}</p>
  <p class="mt-3 text-sm text-slate-600 leading-relaxed flex-1">{service.description}</p>

  {service.highlights?.length > 0 && (
    <ul class="mt-5 space-y-1.5">
      {service.highlights.slice(0, 4).map((h) => (
        <li class="flex items-start gap-2 text-sm text-slate-700">
          <svg class="mt-0.5 shrink-0 text-indigo-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{h}</span>
        </li>
      ))}
    </ul>
  )}

  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600">
    See what we build
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    </svg>
  </span>
</a>
