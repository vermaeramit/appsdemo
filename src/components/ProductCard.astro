---
import type { Product } from "../data/products";
interface Props { product: Product; }
const { product } = Astro.props;

const statusPill = {
  live: { text: "Live",        cls: "bg-emerald-100 text-emerald-700" },
  beta: { text: "Beta",        cls: "bg-amber-100  text-amber-700"   },
  soon: { text: "Coming Soon", cls: "bg-slate-100  text-slate-600"   },
}[product.status];

// A "soon" product is clickable only if it has a real href (not "#").
const isClickable = product.status !== "soon" || (product.href && product.href !== "#");
const Tag = isClickable ? "a" : "div";
---

<Tag
  href={isClickable ? product.href : undefined}
  class={[
    "lift relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 sm:p-7",
    isClickable ? "cursor-pointer hover:border-indigo-300" : "opacity-90",
  ].join(" ")}
>
  <div class="flex items-start justify-between">
    <div class={`grid place-items-center w-12 h-12 rounded-xl bg-gradient-to-br ${product.iconColor} text-white text-2xl shadow-sm`}>
      <span aria-hidden="true">{product.icon}</span>
    </div>
    <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full ${statusPill.cls}`}>
      {statusPill.text}
    </span>
  </div>

  <h3 class="mt-5 text-xl font-bold text-slate-900">{product.name}</h3>
  <p class="mt-1 text-sm font-medium text-indigo-600">{product.tagline}</p>
  <p class="mt-3 text-sm text-slate-600 leading-relaxed flex-1">{product.description}</p>

  {product.highlights?.length > 0 && (
    <ul class="mt-5 space-y-1.5">
      {product.highlights.slice(0, 4).map((h) => (
        <li class="flex items-start gap-2 text-sm text-slate-700">
          <svg class="mt-0.5 shrink-0 text-indigo-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{h}</span>
        </li>
      ))}
    </ul>
  )}

  {isClickable ? (
    <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600">
      {product.status === "soon" ? "Preview & join waitlist" : "Learn more"}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
      </svg>
    </span>
  ) : (
    <span class="mt-6 text-sm font-medium text-slate-500">Notify me when this launches →</span>
  )}
</Tag>
