---
import { site } from "../data/site";
---

<section class="relative overflow-hidden">
  <div class="hero-blob"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-16 sm:pb-24">
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/70 backdrop-blur border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Built by indie devs, for growing teams
      </span>

      <h1 class="mt-6 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.05]">
        Software that <span class="gradient-text">runs your business</span> —
        <br class="hidden sm:block"/>not the other way around.
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed">
        {site.name} builds modern SaaS tools small businesses actually enjoy using.
        Start with <strong>TravelERP</strong>, our travel-agency CRM — more products launching soon.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/products/travel-crm"
          class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-cyan-600 shadow-md hover:shadow-lg hover:opacity-95 transition"
        >
          Explore TravelERP
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
          </svg>
        </a>
        <a
          href="#products"
          class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-slate-900 bg-white border border-slate-200 hover:border-indigo-300 hover:text-indigo-600 transition"
        >
          See all products
        </a>
      </div>

      <p class="mt-5 text-xs text-slate-500">
        No credit card · 30-day free trial · Cancel anytime
      </p>
    </div>

    <!-- Decorative dashboard mockup -->
    <div class="relative mt-14 sm:mt-20 max-w-5xl mx-auto">
      <div class="relative rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-indigo-500/10 overflow-hidden">
        <!-- Window chrome -->
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-slate-200 bg-slate-50">
          <span class="w-3 h-3 rounded-full bg-rose-400"></span>
          <span class="w-3 h-3 rounded-full bg-amber-400"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
          <span class="ml-3 text-xs text-slate-500 font-mono truncate">crm.appsdemo.in / Dashboard</span>
        </div>
        <!-- Fake dashboard -->
        <div class="p-5 sm:p-8 grid grid-cols-1 md:grid-cols-3 gap-4 bg-gradient-to-br from-slate-50 to-white">
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active Leads</p>
            <p class="mt-1 text-3xl font-extrabold text-slate-900">128</p>
            <p class="mt-1 text-xs text-emerald-600 font-semibold">+18% this month</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Quotes Sent</p>
            <p class="mt-1 text-3xl font-extrabold text-slate-900">64</p>
            <p class="mt-1 text-xs text-emerald-600 font-semibold">+9% this month</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Bookings</p>
            <p class="mt-1 text-3xl font-extrabold text-slate-900">₹4.2L</p>
            <p class="mt-1 text-xs text-emerald-600 font-semibold">+27% this month</p>
          </div>
          <div class="md:col-span-3 rounded-xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between">
              <p class="text-sm font-semibold text-slate-900">Today's follow-ups</p>
              <span class="text-xs font-semibold text-indigo-600">4 due</span>
            </div>
            <ul class="mt-3 space-y-2">
              <li class="flex items-center gap-3 text-sm">
                <span class="w-1.5 h-8 rounded bg-rose-400"></span>
                <div class="flex-1">
                  <p class="font-medium text-slate-900">Call · Priya Sharma · Dubai package</p>
                  <p class="text-xs text-slate-500">Overdue · LD-2026-0042</p>
                </div>
              </li>
              <li class="flex items-center gap-3 text-sm">
                <span class="w-1.5 h-8 rounded bg-amber-400"></span>
                <div class="flex-1">
                  <p class="font-medium text-slate-900">Email · Rohit Mehta · Bali honeymoon</p>
                  <p class="text-xs text-slate-500">Today, 4:00 PM · LD-2026-0044</p>
                </div>
              </li>
              <li class="flex items-center gap-3 text-sm">
                <span class="w-1.5 h-8 rounded bg-indigo-400"></span>
                <div class="flex-1">
                  <p class="font-medium text-slate-900">WhatsApp · Kavya Iyer · Switzerland</p>
                  <p class="text-xs text-slate-500">Today, 5:30 PM · LD-2026-0046</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <!-- Decorative glow -->
      <div class="absolute -inset-2 -z-10 rounded-3xl bg-gradient-to-tr from-indigo-500/20 to-cyan-500/20 blur-2xl"></div>
    </div>
  </div>
</section>
