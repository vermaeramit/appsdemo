{
  // Cloudflare Worker config — controls how the site deploys.
  // Worker handles /api/contact via src/worker.ts; everything else
  // falls through to the static Astro output in ./dist.
  "name": "appsdemo",
  "main": "./src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  "build": {
    "command": "npm run build"
  },

  "observability": {
    "enabled": true
  }
}
